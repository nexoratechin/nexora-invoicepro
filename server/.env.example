NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=info
APP_VERSION=0.1.0

# Required from Stage 3 onward, when the API starts talking to MongoDB.
# MONGODB_URI=mongodb://127.0.0.1:27017/nexora_invoicepro

# Required from Stage 3 onward.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Required only when the forgot-password flow is enabled.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
